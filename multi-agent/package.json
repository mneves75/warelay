{
  "name": "warelay-multi-agent",
  "version": "1.0.0",
  "description": "Multi-agent router for warelay WhatsApp automation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "warelay-router": "dist/index.js"
  },
  "scripts": {
